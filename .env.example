# Build-only public facts. No account, AWS, backend, payment or signing secrets belong in renderer variables.
BUILD_CHANNEL=stable
BUILD_DISTRIBUTION=development
# SOURCE_DATE_EPOCH=<source commit Unix timestamp for a repeatable build timestamp>

# Protected Windows release CI only; never commit actual values.
# MELDIQ_RELEASE_APPROVED=1
# MELDIQ_SIGNING_PUBLISHER=<exact Authenticode certificate common name>
# CSC_LINK=<protected certificate path or base64>
# CSC_KEY_PASSWORD=<protected certificate password>
# Acceptance JSON is an external signed-off artifact, not a self-certification.
# MELDIQ_RELEASE_ACCEPTANCE_JSON=<protected evidence referencing the exact source commit>
