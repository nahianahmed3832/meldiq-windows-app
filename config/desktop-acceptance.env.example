# Copy to ~/Library/Application Support/Meldiq/desktop-acceptance.env and chmod 600.
# Harness configuration only. Never source this file, export it, or pass it to a build.
# Empty values: REQUIRED FROM INFRASTRUCTURE OWNER. No accounts are provisioned by scripts.
MELDIQ_ACCEPTANCE_API_ORIGIN=https://web.meldiq.app
MELDIQ_ACCEPTANCE_WS_URL=wss://web.meldiq.app/v1/ws
MELDIQ_ACCEPTANCE_APP_ORIGIN=https://web.meldiq.app
MELDIQ_ACCEPTANCE_MEDIA_ORIGIN=https://griipbuddy-orbit-media-sg.s3.ap-southeast-1.amazonaws.com
MELDIQ_ACCEPTANCE_LIVEKIT_URL=wss://rtc.meldiq.app
# Origins above are observed deployment configuration; approval is still required.
MELDIQ_ACCEPTANCE_ORIGINS_APPROVED=false
MELDIQ_ACCEPTANCE_QA_AUTHORIZED=false
MELDIQ_ACCEPTANCE_OWNER_REFERENCE=
MELDIQ_ACCEPTANCE_QA_A_EMAIL=
MELDIQ_ACCEPTANCE_QA_A_PASSWORD=
MELDIQ_ACCEPTANCE_QA_B_EMAIL=
MELDIQ_ACCEPTANCE_QA_B_PASSWORD=
MELDIQ_ACCEPTANCE_QA_C_EMAIL=
MELDIQ_ACCEPTANCE_QA_C_PASSWORD=
MELDIQ_ACCEPTANCE_QA_COMMUNITY_ID=
MELDIQ_ACCEPTANCE_QA_CHANNEL_ID=
MELDIQ_ACCEPTANCE_QA_A_USER_ID=
MELDIQ_ACCEPTANCE_QA_B_USER_ID=
MELDIQ_ACCEPTANCE_QA_C_USER_ID=
# Transactions require a separate isolated deployment. Never point this at production.
MELDIQ_ACCEPTANCE_SANDBOX_API_ORIGIN=
MELDIQ_ACCEPTANCE_SANDBOX_ISOLATED=false
MELDIQ_ACCEPTANCE_PAYMENT_MODE=
