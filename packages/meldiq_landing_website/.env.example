# Meldiq website: build-time settings only. Nothing secret belongs here: everything in NEXT_PUBLIC_* ends up in the
# browser. PayPal secrets and payment-provider credentials live only in the API server's environment (meldiq_android/deploy/.env).

# The existing Meldiq web app ("Open Meldiq" links). Never served by this site.
NEXT_PUBLIC_WEB_APP_URL=https://web.meldiq.app
# This site's own address (canonical links, sitemap).
NEXT_PUBLIC_SITE_URL=https://meldiq.app
# Development only: the API `next dev` proxies /v2 to (a local server from meldiq_android/server).
MELDIQ_API_UPSTREAM=http://127.0.0.1:8080
